{
  "manifest_version": 3,
  "name": "X Post Deleter",
  "version": "1.3.0",
  "description": "Automatically detect your X account and delete discoverable posts and replies in a separate background tab.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "minimum_chrome_version": "102"
}
